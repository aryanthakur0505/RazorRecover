# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list is not needed; single origin of your deployed/local frontend
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Hosted Postgres connection string (Neon/Supabase/Render Postgres/etc). Include ?sslmode=require in production.
DATABASE_URL=postgresql://user:password@localhost:5432/razorrecover

# --- Razorpay Test Mode ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this in the Razorpay Dashboard webhook config, and here so signatures verify
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- AI reasoning layer ---
# If unset, the AI layer reports "unavailable" and ambiguous cases route straight to human
# review — a safe, expected fallback, not an error.
#
# Uses OpenAI by default. To use a free alternative instead (no code changes needed — both speak
# the same OpenAI-compatible chat-completions + tool-calling API this app already uses), set
# OPENAI_BASE_URL too:
#   Groq (https://console.groq.com — free, no card required):
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=llama-3.3-70b-versatile
#   Gemini (https://aistudio.google.com — free tier):
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Session ---
# Any long random string; signs the mock merchant session cookie
SESSION_SECRET=change-me-to-a-long-random-string
